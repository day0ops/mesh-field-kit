[0.000, "o", "\u001b[36m\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[22m\u001b[39m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m  Use case: add-services-to-mesh\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[22m\u001b[39m\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "\u001b[37mAdd Bookinfo workloads to the ambient mesh on multiple clusters.\u001b[39m\r\n\u001b[37m• Namespaces are labeled istio.io/dataplane-mode=ambient when applications deploy\u001b[39m\r\n\u001b[37m• Workloads in labeled namespaces are enrolled in ambient L4 dataplane (ztunnel)\u001b[39m\r\n\u001b[37m\u001b[39m\r\n\r\n"]
[0.125, "o", "\u001b[2m  Data flow:\u001b[22m\r\n"]
[0.000, "o", "\u001b[2m┌──────────────────────────────────┐\u001b[22m\r\n\u001b[2m│              west                │\u001b[22m\r\n\u001b[2m│                                  │\u001b[22m\r\n\u001b[2m│                                  │\u001b[22m\r\n\u001b[2m│ ┌──────────┐     ┌─────────────┐ │\u001b[22m\r\n\u001b[2m│ │          │     │             │ │\u001b[22m\r\n\u001b[2m│ │          │     │             │ │\u001b[22m\r\n\u001b[2m│ │ bookinfo ├────►│ productpage │ │\u001b[22m\r\n\u001b[2m│ │ ambient  │     │             │ │\u001b[22m\r\n\u001b[2m│ │          │     │             │ │\u001b[22m\r\n\u001b[2m│ └─────┬────┘     └─────────────┘ │\u001b[22m\r\n\u001b[2m│       │                          │\u001b[22m\r\n\u001b[2m│       │                          │\u001b[22m\r\n\u001b[2m│       └───────┐                  │\u001b[22m\r\n\u001b[2m│               │                  │\u001b[22m\r\n\u001b[2m│  "]
