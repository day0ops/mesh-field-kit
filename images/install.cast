[0.000, "o", "\u001b[?25l"]
[0.000, "o", "\u001b[32m?\u001b[39m \u001b[1mSelect from \u001b[36mtraffic management\u001b[39m:\u001b[22m\u001b[33m  (enter/space to select, esc to go back)\u001b[39m\r\n\u001b[36m❯\u001b[39m \u001b[36madd services to mesh\u001b[39m\r\n  global service discovery\r\n  global service discovery with kgateway\r\n  global service failover\r\n  global service takeover\r\n  kgateway cluster draining\r\n  kgateway global ingress\r\n  kgateway serviceentry exclusion\r\n  locality failover\r\n  segmented canary\r\n  waypoint resiliency\r\n\u001b[2m ────────────────\u001b[22m\r\n  \u001b[2m← Back\u001b[22m\r\n"]
[1.709, "o", "\u001b[14A\u001b[0J\u001b[32m✔\u001b[39m \u001b[1mSelect from \u001b[36mtraffic management\u001b[39m:\u001b[22m \u001b[36madd-services-to-mesh\u001b[39m\r\n\u001b[?25h"]
[0.001, "o", "\u001b[34m\u001b[34mℹ\u001b[39m\u001b[34m\u001b[39m Selected use case: add-services-to-mesh\r\n"]
